# Puerto del servidor
PORT=3000

# Secreto para JWT
JWT_SECRET=tu_clave_secreta_jwt

# Variables para base de datos PostgreSQL
DB_USER=postgres
DB_HOST=localhost
DB_NAME=Gym
DB_PASSWORD=tu_password
DB_PORT=5432

# Token para Decolecta API (RENIEC)
# https://decolecta.com/profile/
DECOLECTA_TOKEN=tu_token_aqui

# Correo para envío de notificaciones y comprobantes (Gmail App Password)
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASS=tu_password_de_aplicacion
EMAIL_FROM="VolcanoGym"

# Datos de la empresa emisora
EMPRESA_RUC=20000000001
EMPRESA_RAZON_SOCIAL="VOLCANO GYM SAC"
EMPRESA_NOMBRE_COMERCIAL="Volcano Gym"
EMPRESA_UBIGUEO=140105
EMPRESA_DEPARTAMENTO=Lambayeque
EMPRESA_PROVINCIA=Chiclayo
EMPRESA_DISTRITO="Jose Leonardo Ortiz"
EMPRESA_DIRECCION="Av. Principal 123"
